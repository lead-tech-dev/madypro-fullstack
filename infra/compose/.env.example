# Copier en .env côté VPS (/srv/madypro/prod/.env et /srv/madypro/dev/.env)
# JAMAIS commiter les valeurs réelles.

POSTGRES_PASSWORD=changeme

# Auth
JWT_SECRET=changeme
JWT_EXPIRES_IN=7d

# CORS / URL front (adapter par environnement)
CORS_ORIGIN=https://app.madyproclean.com
WEB_APP_URL=https://app.madyproclean.com

# Email (Resend)
RESEND_API_KEY=re_xxx
RESEND_FROM="Madypro Clean <no-reply@madyproclean.com>"

# Firebase Cloud Messaging (notifications push)
FCM_PROJECT_ID=xxx
FCM_CLIENT_EMAIL=xxx
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

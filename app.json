{
  "expo": {
    "name": "MadyPro Clean",
    "slug": "mj-planning-mobile",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.maximan81.mjplanningmobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "com.maximan81.mjplanningmobile",
      "supportsTablet": false
    },
    "extra": {
      "eas": {
        "projectId": "17de6227-dae4-4b36-b6c2-88433b7e1a0a"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "MadyPro Clean utilise l'appareil photo pour scanner les codes-barres de l'inventaire."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font"
    ]
  }
}
